void main() { Map<String, String> estadosSudeste = { "São Paulo": "SP", "Rio de Janeiro": "RJ", "Minas Gerais": "MG", "Espírito Santo": "ES", }; print("Siglas:"); for (var sigla in estadosSudeste.values) { print(sigla); } print("\nEstados:"); for (var estado in estadosSudeste.keys) { print(estado); } print("\nUF\t\tSigla"); estadosSudeste.forEach((estado, sigla) { print("$estado\t$sigla"); });}